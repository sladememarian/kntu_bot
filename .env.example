# ==========================================
# KNTU Bot 25 - Configuration
# ==========================================

# Telegram Bot Token (get from @BotFather)
BOT_TOKEN=YOUR_BOT_TOKEN_HERE

# Google Gemini API Key (fallback for Bob if other providers fail)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# --- MongoDB (bundled via docker-compose) ---
MONGO_INITDB_ROOT_USERNAME=admin
MONGO_INITDB_ROOT_PASSWORD=change_me
DATABASE_URL=mongodb://admin:change_me@mongo:27017/admin?authSource=admin

# --- AI features master switch ---
# false = /ai, /ai3, /ai3stats and passive AI learners are disabled.
# Crisis/suicide detection stays active regardless.
# Bob (/bob) always runs (Hermes-style brain) independent of this flag.
AI_ENABLED=false

# Bot Admin User IDs (comma-separated Telegram user IDs)
ADMIN_IDS=123456789

# News channels to monitor (comma-separated channel usernames without @)
NEWS_CHANNELS=

DEFAULT_LANG=fa
DEBUG=false

# ==========================================
# Bob = REAL NousResearch Hermes Agent
# (/bob, /bobstats)
# Docs: https://hermes-agent.nousresearch.com/docs/user-guide/configuration
# ==========================================
# Hermes natively reads OPENCODE_ZEN_API_KEY.
# entrypoint.sh also maps OPENCODE_API_KEY(S) → OPENCODE_ZEN_API_KEY.
# Primary: OpenCode Zen (OpenAI-compatible) — free models work well
OPENCODE_API_KEY=
# Comma-separated keys for rotation
OPENCODE_API_KEYS=
OPENCODE_BASE_URL=https://opencode.ai/zen/v1
OPENCODE_MODELS=north-mini-code-free,big-pickle

# Optional NVIDIA Integrate (OpenAI-compatible)
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODELS=google/gemma-4-31b-it,deepseek-ai/deepseek-v4-flash,z-ai/glm-5.2,thinkingmachines/inkling

# Optional generic OpenAI-compatible endpoint (Thinking Machines, vLLM, etc.)
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODELS=

# Optional: path to a NousResearch/hermes-agent git checkout for native AIAgent
# HERMES_HOME=/opt/hermes-agent
# HERMES_MODEL=north-mini-code-free
# HERMES_BASE_URL=https://opencode.ai/zen/v1
# HERMES_TOOLSETS=
# HERMES_MAX_ITERATIONS=12

BOB_MAX_TOKENS=512
BOB_TEMPERATURE=0.8
BOB_MAX_AUTO_REPLIES_PER_DAY=3
BOB_AUTO_MENTION_CHANCE=0.35
BOB_AUTO_BASE_CHANCE=0.0

# ==========================================
# HTML5 Casino web server + Daytona preview
# ==========================================
# MUST be false for /casinogame to serve static/casino.html + /api/*
DISABLE_AIOHTTP_SERVER=false
PORT=8091

# Public base used by Telegram Play button (standard preview host)
# Example: https://8091-<sandboxId>.daytonaproxy01.eu
WEB_URL=

# Optional: pre-minted Daytona *signed* preview URL (token embedded in host).
# Prefer this for Telegram WebView (no auth header needed).
# CASINO_SIGNED_URL=https://8091-<token>.daytonaproxy01.eu

# Mint signed URLs automatically on each Play click (required for Telegram WebView).
DAYTONA_API_KEY=dtn_...
DAYTONA_SANDBOX_ID=26f0e993-32b4-45f2-af64-a392bee6cc43
DAYTONA_API_URL=https://app.daytona.io/api
DAYTONA_SIGNED_EXPIRES=3600

# Note on Daytona "I Understand, Continue" warning:
# Browsers show a one-time interstitial on standard/signed preview hosts.
# Skip options per Daytona docs: header X-Daytona-Skip-Preview-Warning (not
# available inside Telegram WebView), Tier 3 org, or a custom preview proxy.
# Making the sandbox public + using signed URLs removes *auth* failures that
# often make the Continue button appear broken.
