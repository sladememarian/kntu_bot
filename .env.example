# ==========================================
# KNTU Bot 25 - Configuration
# ==========================================

# Telegram Bot Token (get from @BotFather)
BOT_TOKEN=YOUR_BOT_TOKEN_HERE

# Google Gemini API Key (only needed if AI_ENABLED=true)
GEMINI_API_KEY=

# --- MongoDB (bundled via docker-compose) ---
# Credentials for the compose "mongo" service. Must match DATABASE_URL.
MONGO_INITDB_ROOT_USERNAME=admin
MONGO_INITDB_ROOT_PASSWORD=change_me
# Internal connection string (service name "mongo", container port 27017).
DATABASE_URL=mongodb://admin:change_me@mongo:27017/admin?authSource=admin

# --- AI features master switch ---
# false = /ai, /ai3, /ai3stats and passive AI learners are disabled.
# Crisis/suicide detection stays active regardless.
AI_ENABLED=false

# Bot Admin User IDs (comma-separated Telegram user IDs)
ADMIN_IDS=123456789,987654321

# News channels to monitor (comma-separated channel usernames without @)
NEWS_CHANNELS=channel1,channel2,channel3

# Language setting: fa (Persian) or en (English) — default is fa
DEFAULT_LANG=fa

# Debug mode: true or false
DEBUG=false

# Disable the built-in aiohttp web/game server (pure Telegram polling)
DISABLE_AIOHTTP_SERVER=true
