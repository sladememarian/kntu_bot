# ==========================================
# KNTU Bot 25 - Configuration
# ==========================================

# Telegram Bot Token (get from @BotFather)
BOT_TOKEN=YOUR_BOT_TOKEN_HERE

# Google Gemini API Key (fallback for Bob if other providers fail)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Tenor GIF search API key (used by markov_ai.py for GIF search)
TENOR_API_KEY=

# --- MongoDB (bundled via docker-compose) ---
MONGO_INITDB_ROOT_USERNAME=admin
MONGO_INITDB_ROOT_PASSWORD=change_me
DATABASE_URL=mongodb://admin:change_me@mongo:27017/admin?authSource=admin

# --- AI features master switch ---
# false = /ai, /ai3, /ai3stats and passive AI learners are disabled.
# Crisis/suicide detection stays active regardless.
# Bob (/bob) always runs (Hermes brain) independent of this flag.
AI_ENABLED=false

# Bot Admin User IDs (comma-separated Telegram user IDs)
ADMIN_IDS=123456789

# News channels to monitor (comma-separated channel usernames without @)
NEWS_CHANNELS=

DEFAULT_LANG=fa
DEBUG=false

# ==========================================
# Bob = REAL NousResearch Hermes Agent
# ==========================================
# Provider chain order: OpenCode Zen -> Gemini -> NVIDIA (last resort)
# Health tracking: 10 failures → 1.5d cooldown, 2d → auto-retry.
#
# Primary: OpenCode Zen
OPENCODE_API_KEY=
OPENCODE_API_KEYS=
OPENCODE_BASE_URL=https://opencode.ai/zen/v1
OPENCODE_MODELS=north-mini-code-free,big-pickle,mimo-v2.5-free,nemotron-3-ultra-free,deepseek-v4-flash-free

# Fallback 2: Gemini
GEMINI_MODELS=gemini-3-flash-preview

# Fallback 3: NVIDIA Integrate (may be blocked from EU sandboxes)
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODELS=z-ai/glm-5.2,thinkingmachines/inkling,deepseek-ai/deepseek-v4-flash,google/gemma-4-31b-it

# Hermes configuration
HERMES_HOME=/opt/hermes-agent
# HERMES_MODEL removed — auto-resolved from chain by health tracking
HERMES_TOOLSETS=memory,session_search,skill_manage,skill_view,skills_list,web_search,web_extract,todo,kanban,cronjob,clarify,delegate_task,text_to_speech,tool_search,tool_describe,tool_call
HERMES_MAX_ITERATIONS=20
# Enable cronjob tool (requires hermes gateway start process running)
HERMES_INTERACTIVE=true
# Enable kanban tools
HERMES_KANBAN_TASK=true

# Model fallback chain (when primary fails, try in order)
FALLBACK_MODEL_1=big-pickle
FALLBACK_MODEL_2=mimo-v2.5-free
FALLBACK_MODEL_3=north-mini-code-free

BOB_MAX_TOKENS=1024
BOB_TEMPERATURE=0.8
BOB_MAX_AUTO_REPLIES_PER_DAY=5
BOB_AUTO_MENTION_CHANCE=0.35
BOB_AUTO_BASE_CHANCE=0.0

# ==========================================
# HTML5 Casino web server + Daytona preview
# ==========================================
# MUST be false for /casinogame to serve static/casino.html + /api/*
DISABLE_AIOHTTP_SERVER=false
PORT=8091

# Public base used by Telegram Play button (standard preview host)
# Example: https://8091-<sandboxId>.daytonaproxy01.eu
WEB_URL=

# Cloudflare Worker proxy -- bypasses Daytona "I Understand, Continue" warning page.
# CASINO_PROXY_URL=https://kntu-casino-proxy.<your-username>.workers.dev

# Optional: pre-minted Daytona *signed* preview URL (token embedded in host).
# CASINO_SIGNED_URL=https://8091-<token>.daytonaproxy01.eu

# Mint signed URLs automatically on each Play click
DAYTONA_API_KEY=dtn_...
DAYTONA_SANDBOX_ID=your-sandbox-id
DAYTONA_API_URL=https://app.daytona.io/api
DAYTONA_SIGNED_EXPIRES=3600
